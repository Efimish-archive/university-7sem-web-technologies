<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{ title }}</title>
    <link rel="icon" href="/favicon.ico" />
    <link rel="stylesheet" href="/style.css" />
  </head>
  <body>
    {{{ pageList }}}
    <main>
      <h1>{{ title }}</h1>
      <p>{{ content }} от композитора {{ author }}</p>
      <table>
        <tr>
          <td>Название</td>
          <td>Плеер</td>
        </tr>
        {{ #tracks }}
        <tr>
          <td>{{ title }}</td>
          <td>
            <audio controls>
              <source src="{{ src }}" type="audio/mpeg" />
            </audio>
          </td>
        </tr>
        {{ /tracks }}
      </table>
    </main>
  </body>
</html>
