<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{ title }}</title>
    <link rel="icon" href="/favicon.ico" />
    <link rel="stylesheet" href="/style.css" />
  </head>
  <body>
    {{{ pageList }}}
    <main>
      <h1>{{ title }}</h1>

      <h2>Список игр</h2>
      <ul>
        {{ #games }}
        <li>
          <p>{{ title }}</p>
          <img src="{{ image }}" alt="" width="100" />
        </li>
        {{ /games }}
      </ul>
    </main>
  </body>
</html>
