<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{ title }}</title>
    <link rel="icon" href="/favicon.ico" />
    <link rel="stylesheet" href="/style.css" />
  </head>
  <body>
    {{{ pageList }}}
    <main>
      <h1>{{ title }}</h1>
      <p>{{ content }}</p>
      <h2>Наша команда:</h2>
      <table>
        <tr>
          <td>Должность</td>
          <td>Описание</td>
          <td>Работник</td>
        </tr>
        {{ #team }}
        <tr>
          <td>{{ role }}</td>
          <td>{{ emoji }}</td>
          <td>{{ name }}</td>
        </tr>
        {{ /team }}
      </table>
    </main>
  </body>
</html>
